BYBIT_TESTNET=true

# ── Bot settings ──
SIGNAL_COOLDOWN_SEC=60
BTC_SPAM_THRESHOLD=5
BTC_SPAM_WINDOW_SEC=120
MIN_SETUP_QUALITY=2
